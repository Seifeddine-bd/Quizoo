<resources>
    <style name="Theme.Quizoo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryDarkColor</item>
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorOnPrimary">@color/textPrimary</item>
        <item name="colorOnSecondary">@color/textPrimary</item>
        <item name="android:windowBackground">@color/backgroundDark</item>
        <item name="android:statusBarColor">@color/primaryDarkColor</item>
        <item name="android:navigationBarColor">@color/backgroundDark</item>
        <!-- Use a fallback style if Widget.MaterialComponents.Button.ElevatedButton is not found -->
        <item name="materialButtonStyle">@style/Quizoo.Button.ElevatedButton</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Quizoo.HeadlineMedium</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Quizoo.BodyMedium</item>
    </style>
    <style name="Theme.Quizoo.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.Quizoo.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <style name="RoundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Custom ElevatedButton style as a fallback -->
    <style name="Quizoo.Button.ElevatedButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/primaryColor</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:padding">12dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.Quizoo.HeadlineMedium" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Quizoo.BodyMedium" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="MaterialAlertDialog_Rounded" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.MaterialAlertDialog.Rounded</item>
    </style>

    <style name="ShapeAppearanceOverlay.MaterialAlertDialog.Rounded" parent="">
        <item name="cornerSize">16dp</item>
    </style>
</resources>